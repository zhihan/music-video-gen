# =============================================================================
# Music Video Generator - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic Claude API (Required for Research Agent)
# -----------------------------------------------------------------------------
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# KIE.ai API (Optional - for Suno music generation)
# -----------------------------------------------------------------------------
# Sign up at https://kie.ai/ and get your API key at https://kie.ai/api-key
KIE_API_KEY=your-kie-api-key

# -----------------------------------------------------------------------------
# Google Cloud / Veo 3 Configuration (Required for video generation)
# -----------------------------------------------------------------------------
# 1. Create a Google Cloud project at https://console.cloud.google.com/
# 2. Enable the Vertex AI API
# 3. Create a service account with Vertex AI User role
# 4. Download the service account JSON key

# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Your Google Cloud project ID (not project number)
GOOGLE_CLOUD_PROJECT=your-project-id

# GCS bucket for Veo output (must start with gs://)
# Create a bucket in the same region as your Vertex AI endpoint (us-central1)
# Example: gs://my-project-veo-output
# Unused please delete
VEO_OUTPUT_BUCKET=gs://your-bucket-name

# Veo model name (optional, defaults to veo-3.1-fast-generate-001)
# VEO_MODEL=veo-3.1-fast-generate-001

# -----------------------------------------------------------------------------
# Workspace Configuration
# -----------------------------------------------------------------------------
# Working directory for MVG (defaults to current directory)
MVG_WORKSPACE=.
